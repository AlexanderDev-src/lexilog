# AI writing feedback (optional). Copy this file to .env and add AI_API_KEY.
# Without a key the app runs with AI feedback switched off.
# .env is in .gitignore: never commit the real key.

AI_BASE_URL=https://gen.ai.kku.ac.th/api/v1
AI_API_KEY=

# model:daily_tokens, comma separated, one model per quota on the gateway's
# usage page. Add :vision to models that can read images: only those are
# sent the Task 1 chart. Checked on 2026-09-26 with a test chart: all of
# these read images except deepseek (the gateway says "No endpoints found
# that support image input"). Model names come from
# https://gen.ai.kku.ac.th/api/v1/models (the usage page uses other names).
AI_MODELS=claude-sonnet-5:200000:vision,gemini-3.8-flash:350000:vision,gpt-5.6-luna:200000:vision,deepseek-v4-pro:1000000,llama-4-maverick:200000:vision,nova-2-lite-v1:200000:vision,grok-4.5:100000:vision,qwen3.7-plus:100000:vision,mistral-large-2512:100000:vision,minimax-m3:100000:vision,kimi-k3:100000:vision
AI_DEFAULT_MODEL=claude-sonnet-5
